{
    "name": "ernestdefoe/member-map",
    "description": "Member Map: an opt-in map of where your community's members are, with a city search, a privacy-first precision choice (city, region or country), a Near me list, and a location line on profiles.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "map",
        "member map",
        "location",
        "openstreetmap",
        "leaflet"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/member-map",
    "support": {
        "issues": "https://github.com/ernestdefoe/member-map/issues",
        "source": "https://github.com/ernestdefoe/member-map"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\MemberMap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\MemberMap\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Member Map",
            "category": "feature",
            "icon": {
                "name": "fas fa-map-location-dot",
                "backgroundColor": "#0f766e",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/gdpr",
                "flarum/suspend"
            ]
        }
    },
    "require-dev": {
        "flarum/gdpr": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
