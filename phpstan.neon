includes:
    - vendor/flarum/phpstan/extension.neon

parameters:
    # One process: flarum/phpstan's bootstrap installs a test forum the first
    # time it runs, and parallel workers each start that install at once on a
    # fresh checkout (CI), failing with Install\StepFailed.
    parallel:
        maximumNumberOfProcesses: 1
    level: 6
    paths:
        - extend.php
        - src
    ignoreErrors:
        # Page Builder is a private package: its extender is only built when it is enabled (Extend\Conditional).
        -
            identifier: class.notFound
            message: '#Ernestdefoe\\PageBuilder\\Extend\\PageBuilderBlock#'
            path: extend.php
    excludePaths:
        # Implements Page Builder's interface; loaded only when Page Builder is installed.
        - src/Widget/WhereWeAreBlock.php
        # Uses Calendar's model; registered only when Calendar is enabled (Extend\Conditional).
        - src/Integrations/AddMeetupToCalendar.php
